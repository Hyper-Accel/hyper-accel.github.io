{
  "name": "@hyperaccel/blog-editor",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names api,web,hugo \"bun --watch src/server/index.ts\" \"vite --open /\" \"hugo server -s ../.. --bind 127.0.0.1 --port 1413 --disableFastRender\"",
    "build": "vite build && bun build src/server/index.ts --target bun --outdir dist-server",
    "build:site": "vite build --mode site",
    "build:shell": "cd ../.. && hugo --quiet --destination tools/editor/dist-site --baseURL http://127.0.0.1:4175/",
    "dev:site": "bun run build:site && bun run build:shell && bun run src/testing/dev-site.ts",
    "e2e:site": "bun run build:site && bun run build:shell && bun run src/e2e/site-flow.e2e.ts && bun run src/e2e/site-recovery.e2e.ts",
    "ci:dry-run": "bun run check && bun run build:site && bun test ci && bun ci/validate-posts.ts --root ../.. --all",
    "start": "bun run dist-server/index.js",
    "test": "bun test",
    "e2e": "bun run src/e2e/editor.e2e.ts && bun run src/e2e/agent-ui.e2e.ts && bun run src/e2e/session-restart.e2e.ts",
    "e2e:agents": "bun run src/e2e/agent-live.e2e.ts",
    "typecheck": "tsc --noEmit",
    "check": "biome check . && bun run typecheck && bun test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@hono/zod-validator": "^0.7.2",
    "@phosphor-icons/web": "^2.1.2",
    "@tiptap/core": "^3.27.0",
    "@tiptap/extension-code-block-lowlight": "3.30.5",
    "@tiptap/extension-image": "^3.27.0",
    "@tiptap/extension-link": "^3.27.0",
    "@tiptap/extension-placeholder": "^3.27.0",
    "@tiptap/extension-table": "3.30.5",
    "@tiptap/markdown": "^3.27.0",
    "@tiptap/starter-kit": "^3.27.0",
    "dompurify": "^3.2.7",
    "highlight.js": "11",
    "hono": "^4.9.8",
    "katex": "0.16.25",
    "ky": "^1.10.0",
    "lowlight": "3",
    "marked": "^17.0.1",
    "mathlive": "0.111.1",
    "yaml": "^2.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.2",
    "@types/bun": "^1.2.21",
    "@types/katex": "^0.16.7",
    "fake-indexeddb": "^6.2.2",
    "concurrently": "^9.2.1",
    "playwright": "^1.55.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
